{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": {
    "groups": [
      ["side_effect_style", "side_effect"],
      { "newlinesBetween": true },
      ["builtin", "external"],
      { "newlinesBetween": true },
      ["internal", "subpath"],
      { "newlinesBetween": true },
      ["parent", "sibling", "index"]
    ],
    "newlinesBetween": true
  },
  "sortPackageJson": false
}

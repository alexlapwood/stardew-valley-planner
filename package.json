{
  "name": "stardew-valley-planner",
  "version": "1.0.0",
  "description": "Stardew Valley seasonal planner",
  "scripts": {
    "start": "vite --host",
    "dev": "npm start",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test -- --run && npm run build",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "vite build",
    "preview": "vite build && vite preview --host"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "immutable": "^5.1.9",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/file-saver": "^2.0.7",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    }
  }
}

{
  "name": "stardew-valley-planner",
  "version": "1.0.0",
  "description": "Stardew Valley seasonal planner",
  "scripts": {
    "start": "vite --host",
    "dev": "npm start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "vite build",
    "preview": "vite build && vite preview --host",
    "ci:build": "npm run build",
    "ci:lint": "npm run lint",
    "ci:test": "vitest run --reporter=default --reporter=github-actions --reporter=junit --outputFile.junit=tests/__temp/test-results.xml"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "firebase": "^13.2.0",
    "immutable": "^5.1.9",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/file-saver": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-solid": "^0.13.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}

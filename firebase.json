{
  "hosting": {
    "ignore": ["**/.*", "**/node_modules/**", "firebase.json"],
    "public": "dist",
    "rewrites": [
      {
        "source": "/robots.txt",
        "destination": "/robots.txt"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
